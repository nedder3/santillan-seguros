<Window x:Class="FederacionSantillan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Federación Santillán — Sistema Integral de Seguros &amp; Prevención" 
        Height="780" Width="1160"
        MinHeight="650" MinWidth="950"
        Background="#0B0F19"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilos de Tarjetas Bento Grid -->
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Botones Estilizados -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <!-- Inputs de Texto -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header con métricas superiores -->
            <RowDefinition Height="Auto"/>
            <!-- Área Principal Bento Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER HERO -->
        <Border Grid.Row="0" Style="{StaticResource BentoCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="FEDERACIÓN SANTILLÁN" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Sistema de Gestión de Pólizas, Siniestros &amp; Auditoría POO" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                    <TextBlock Text="Plataforma de liquidaciones conforme a arquitectura de objetos en memoria C# .NET 8" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Mini KPIs Bento -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="PÓLIZAS ACTIVAS" FontSize="9" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtKpiPolizas" Text="0" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="SINIESTROS" FontSize="9" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtKpiSiniestros" Text="0" FontSize="16" FontWeight="Bold" Foreground="#FBBF24"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,6">
                        <StackPanel>
                            <TextBlock Text="TOTAL LIQUIDADO" FontSize="9" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtKpiLiquidaciones" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="#4ADE80"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL CON PESTAÑAS BENTO -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- PESTAÑA 1: GESTIÓN DE PÓLIZAS -->
            <TabItem Header="01. Pólizas &amp; Asegurados">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Formulario de Emisión -->
                    <Border Grid.Column="0" Style="{StaticResource BentoCard}" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="EMISIÓN DE NUEVA PÓLIZA" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                                <TextBlock Text="Número de Póliza" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpPolNumero" Text="1001" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Tipo de Cobertura" FontSize="11" Foreground="#94A3B8"/>
                                <ComboBox x:Name="CmbPolTipo" SelectedIndex="0" Background="#0F172A" Foreground="#0F172A" Margin="0,3,0,10" Height="28">
                                    <ComboBoxItem Content="AUTO"/>
                                    <ComboBoxItem Content="HOGAR"/>
                                    <ComboBoxItem Content="VIDA"/>
                                    <ComboBoxItem Content="COMERCIO"/>
                                </ComboBox>

                                <TextBlock Text="Suma Asegurada Máxima (USD)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpPolCobertura" Text="1000000" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Deducible / Franquicia (USD)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpPolDeducible" Text="50000" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Prima Anual (USD)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpPolPrima" Text="15000" Style="{StaticResource ModernTextBox}" Margin="0,3,0,14"/>

                                <Separator Background="#1E293B" Margin="0,0,0,14"/>

                                <TextBlock Text="DATOS DEL TITULAR (POO)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="DNI / CUIT Titular" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpTitularDni" Text="20-33445566-9" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Nombre y Apellido" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpTitularNombre" Text="Federico Santillan" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <Button Content="Emitir Póliza en Memoria" Style="{StaticResource PrimaryButton}" Click="BtnEmitirPoliza_Click" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Tabla de Pólizas -->
                    <Border Grid.Column="1" Style="{StaticResource BentoCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CARTERA DE PÓLIZAS REGISTRADAS (HEAP)" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                            <DataGrid x:Name="GridPolizas" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="#0F172A" Foreground="#F8FAFC" RowBackground="#131B2E"
                                      AlternatingRowBackground="#1A243B" BorderBrush="#1E293B" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="80"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="90"/>
                                    <DataGridTextColumn Header="Titular" Binding="{Binding Titular.Nombre}" Width="150"/>
                                    <DataGridTextColumn Header="Cobertura Máx" Binding="{Binding CoberturaMax, StringFormat='${0:N0}'}" Width="110"/>
                                    <DataGridTextColumn Header="Deducible" Binding="{Binding Deducible, StringFormat='${0:N0}'}" Width="90"/>
                                    <DataGridTextColumn Header="Vigencia Inicio" Binding="{Binding VigenciaInicio}" Width="100"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Activa}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: SINIESTROS & LIQUIDACIÓN -->
            <TabItem Header="02. Siniestros &amp; Liquidaciones">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource BentoCard}" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="REGISTRO &amp; LIQUIDACIÓN FNOL" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                                <TextBlock Text="Número de Siniestro" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpSinNumero" Text="901" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Póliza Asociada (Número)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpSinPolizaNum" Text="1001" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Descripción del Hecho" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpSinDescripcion" Text="Colisión lateral en intersección urbana." Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Monto Reclamado Inicial (USD)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpSinMonto" Text="120000" Style="{StaticResource ModernTextBox}" Margin="0,3,0,14"/>

                                <Separator Background="#1E293B" Margin="0,0,0,14"/>

                                <TextBlock Text="PERITAJE TÉCNICO (ASOCIACIÓN POO)" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Perito Asignado" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpPeritoNombre" Text="Ing. Martin Santillan" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <TextBlock Text="Monto Presupuestado Peritado (USD)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBox x:Name="InpPeritoMonto" Text="95000" Style="{StaticResource ModernTextBox}" Margin="0,3,0,10"/>

                                <CheckBox x:Name="ChkDanosValidados" Content="Daños físicos corroborados por perito" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Registrar Siniestro" Style="{StaticResource SecondaryButton}" Click="BtnRegistrarSiniestro_Click" Margin="0,0,8,0"/>
                                    <Button Content="Liquidar Indemnización" Style="{StaticResource PrimaryButton}" Click="BtnLiquidar_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource BentoCard}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="REGISTRO DE SINIESTROS EN GESTIÓN" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                            <DataGrid x:Name="GridSiniestros" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0F172A" Foreground="#F8FAFC" RowBackground="#131B2E"
                                      AlternatingRowBackground="#1A243B" BorderBrush="#1E293B" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Siniestro #" Binding="{Binding Numero}" Width="80"/>
                                    <DataGridTextColumn Header="Póliza #" Binding="{Binding Poliza.Numero}" Width="80"/>
                                    <DataGridTextColumn Header="Titular" Binding="{Binding Poliza.Titular.Nombre}" Width="140"/>
                                    <DataGridTextColumn Header="Reclamado" Binding="{Binding MontoReclamado, StringFormat='${0:N0}'}" Width="100"/>
                                    <DataGridTextColumn Header="Liquidado" Binding="{Binding MontoLiquidado, StringFormat='${0:N0}'}" Width="100"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                                    <DataGridTextColumn Header="Perito" Binding="{Binding Peritaje.Perito}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 3: INSPECTOR DE MEMORIA POO (EXAMEN) -->
            <TabItem Header="03. Inspector de Memoria (POO Exam Mode)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel de Demostración -->
                    <Border Grid.Row="0" Style="{StaticResource BentoCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DEMOSTRADOR EN VIVO DE LA TRÍADA SAGRADA (COPY, CLONE, EQUALS)" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Ejecuta en caliente la creación de objetos, aliasing de referencias en Stack y clonación profunda en Heap para validar las respuestas del examen." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ejecutar Simulacro en Memoria" Style="{StaticResource PrimaryButton}" Click="BtnSimulacroMemoria_Click"/>
                        </Grid>
                    </Border>

                    <!-- Consola Visual de Inspección -->
                    <Border Grid.Row="1" Style="{StaticResource BentoCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtInspectorLog" Background="#0A0E17" Foreground="#38BDF8" 
                                     FontFamily="Consolas" FontSize="12" BorderThickness="0" 
                                     IsReadOnly="True" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
