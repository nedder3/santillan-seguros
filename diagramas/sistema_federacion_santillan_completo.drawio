<diagram id="diagrama-memoria-stack-heap" name="2. Memoria Stack vs Heap">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header Cátedra -->
        <mxCell id="h1" value="&lt;b&gt;SISTEMA FEDERACIÓN SANTILLÁN — DIAGRAMA DE MEMORIA (STACK vs HEAP)&lt;/b&gt;&lt;br&gt;Evaluación de Punteros, Aliasing y Tríada Sagrada (Copy, Clone, Equals) | C# .NET 8&lt;br&gt;Autor: nedder3 (arij.dev@gmail.com) | Cátedra: Programación Orientada a Objetos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;fontColor=#f8fafc;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1300" height="60" as="geometry" />
        </mxCell>

        <!-- ZONA 1: STACK (Variables Locales de Referencia) -->
        <mxCell id="zone_stack" value="VARIABLES LOCALES (STACK / PILA)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontStyle=1;fontSize=13;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="280" height="780" as="geometry" />
        </mxCell>

        <mxCell id="var_a1" value="&lt;b&gt;a1&lt;/b&gt; : Asegurado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;fontColor=#0f172a;" vertex="1" parent="zone_stack">
          <mxGeometry x="30" y="50" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="var_a2" value="&lt;b&gt;a2&lt;/b&gt; : Asegurado (alias a1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;fontColor=#0f172a;" vertex="1" parent="zone_stack">
          <mxGeometry x="30" y="120" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="var_a3" value="&lt;b&gt;a3&lt;/b&gt; : Asegurado (clon de a1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;fontColor=#0f172a;" vertex="1" parent="zone_stack">
          <mxGeometry x="30" y="190" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="var_p1" value="&lt;b&gt;p1&lt;/b&gt; : Poliza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;fontColor=#0f172a;" vertex="1" parent="zone_stack">
          <mxGeometry x="30" y="280" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="var_p2" value="&lt;b&gt;p2&lt;/b&gt; : Poliza (clon profundo p1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;fontColor=#0f172a;" vertex="1" parent="zone_stack">
          <mxGeometry x="30" y="350" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="var_s1" value="&lt;b&gt;s1&lt;/b&gt; : Siniestro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;fontColor=#0f172a;" vertex="1" parent="zone_stack">
          <mxGeometry x="30" y="470" width="220" height="45" as="geometry" />
        </mxCell>

        <!-- Cuadro Resumen Valores de Verdad -->
        <mxCell id="box_truth" value="&lt;b&gt;VALORES DE VERDAD (EXAMEN):&lt;/b&gt;&lt;br&gt;1. a1 == a2 &amp;rarr; &lt;b&gt;TRUE&lt;/b&gt; (Aliasing, mismo puntero)&lt;br&gt;2. a1 == a3 &amp;rarr; &lt;b&gt;FALSE&lt;/b&gt; (Distinta instancia)&lt;br&gt;3. a1.equals(a3) &amp;rarr; &lt;b&gt;TRUE&lt;/b&gt; (Mismo estado)&lt;br&gt;4. p1 == p2 &amp;rarr; &lt;b&gt;FALSE&lt;/b&gt; (Instancias distintas)&lt;br&gt;5. p1.equals(p2) &amp;rarr; &lt;b&gt;TRUE&lt;/b&gt; (Contenido igual)&lt;br&gt;6. p1.VigenciaInicio == p2.VigenciaInicio &amp;rarr; &lt;b&gt;FALSE&lt;/b&gt;&lt;br&gt;7. p1.VigenciaInicio.equals(p2.VigenciaInicio) &amp;rarr; &lt;b&gt;TRUE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="zone_stack">
          <mxGeometry x="15" y="580" width="250" height="180" as="geometry" />
        </mxCell>

        <!-- ZONA 2: HEAP (Instancias en Memoria) -->
        <mxCell id="zone_heap" value="INSTANCIAS EN MEMORIA (HEAP / MONTÍCULO)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontStyle=1;fontSize=13;fontColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="980" height="780" as="geometry" />
        </mxCell>

        <!-- Obj Asegurado 1 -->
        <mxCell id="obj_a1" value="&lt;b&gt;:Asegurado&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;codigo: 1001&lt;br&gt;dni: '20-33445566-9'&lt;br&gt;nombre: 'Federico Santillan'&lt;br&gt;telefono: '11-4455-6677'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="zone_heap">
          <mxGeometry x="50" y="40" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Obj Asegurado 3 (Clon) -->
        <mxCell id="obj_a3" value="&lt;b&gt;:Asegurado (Clon)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;codigo: 1001&lt;br&gt;dni: '20-33445566-9'&lt;br&gt;nombre: 'Federico Santillan'&lt;br&gt;telefono: '11-4455-6677'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="zone_heap">
          <mxGeometry x="50" y="160" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Fechas Póliza 1 -->
        <mxCell id="obj_f1" value="&lt;b&gt;:Fecha (Inicio p1)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;dia: 1 | mes: 1 | ano: 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontSize=11;align=center;" vertex="1" parent="zone_heap">
          <mxGeometry x="400" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obj_f2" value="&lt;b&gt;:Fecha (Fin p1)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;dia: 31 | mes: 12 | ano: 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontSize=11;align=center;" vertex="1" parent="zone_heap">
          <mxGeometry x="400" y="120" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Poliza 1 -->
        <mxCell id="obj_p1" value="&lt;b&gt;:Poliza&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;numero: 5001&lt;br&gt;tipo: 'AUTO'&lt;br&gt;prima: 15000.00&lt;br&gt;coberturaMax: 1000000.00&lt;br&gt;deducible: 50000.00&lt;br&gt;activa: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="zone_heap">
          <mxGeometry x="50" y="280" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Fechas Póliza 2 (Clonadas en profundidad) -->
        <mxCell id="obj_f1_p2" value="&lt;b&gt;:Fecha (Clon p2)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;dia: 1 | mes: 1 | ano: 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontSize=11;align=center;" vertex="1" parent="zone_heap">
          <mxGeometry x="400" y="280" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obj_f2_p2" value="&lt;b&gt;:Fecha (Clon p2)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;dia: 31 | mes: 12 | ano: 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontSize=11;align=center;" vertex="1" parent="zone_heap">
          <mxGeometry x="400" y="360" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Poliza 2 (Clon) -->
