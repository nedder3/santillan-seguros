<diagram id="diagrama-sistema-santillan" name="4. Arquitectura del Sistema">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="920" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Encabezado de Cátedra & Autor -->
        <mxCell id="header_box_sys" value="&lt;b&gt;SISTEMA FEDERACIÓN SANTILLÁN — ARQUITECTURA GENERAL DEL SISTEMA&lt;/b&gt;&lt;br&gt;Capa de Presentación (WPF XAML) | Capa de Coordinación | Dominio POO Puro (C# .NET 8)&lt;br&gt;Autor: nedder3 (arij.dev@gmail.com) | Cátedra: Programación Orientada a Objetos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;fontColor=#f8fafc;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1040" height="60" as="geometry" />
        </mxCell>

        <!-- Capa 1: Presentacion (WPF Desktop UI) -->
        <mxCell id="c1" value="CAPA DE PRESENTACIÓN (WPF / XAML Desktop UI)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="1040" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ui_main" value="&lt;b&gt;MainWindow.xaml&lt;/b&gt;&lt;br&gt;Bento Grid Dashboard&lt;br&gt;(Panel Métricas, Dark Slate Theme)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="30" y="50" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ui_polizas" value="&lt;b&gt;Panel Pólizas&lt;/b&gt;&lt;br&gt;Emisión de pólizas&lt;br&gt;DataGrid reactivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="270" y="50" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ui_siniestros" value="&lt;b&gt;Panel Siniestros&lt;/b&gt;&lt;br&gt;Recepción FNOL&lt;br&gt;Triage &amp; Liquidación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="460" y="50" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ui_peritajes" value="&lt;b&gt;Panel Peritajes&lt;/b&gt;&lt;br&gt;Inspección técnica&lt;br&gt;Validación de daños" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="650" y="50" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ui_inspector" value="&lt;b&gt;Inspector Memoria&lt;/b&gt;&lt;br&gt;Visualizador Stack/Heap&lt;br&gt;Demostración Tríada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="50" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- Capa 2: Logica del Negocio y Coordinador -->
        <mxCell id="c2" value="CAPA DE APLICACIÓN Y COORDINACIÓN" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="1040" height="150" as="geometry" />
        </mxCell>
        <mxCell id="app_sistema" value="&lt;b&gt;SistemaAseguradora&lt;/b&gt;&lt;br&gt;+ emitirPoliza(Poliza)&lt;br&gt;+ registrarSiniestro(Siniestro)&lt;br&gt;+ calcularTotalLiquidaciones()&lt;br&gt;+ buscarPoliza(int): Poliza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="c2">
          <mxGeometry x="270" y="40" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="app_liquidaciones" value="&lt;b&gt;Gestor de Liquidación &amp; Peritaje&lt;/b&gt;&lt;br&gt;Aplica reglas de indemnización:&lt;br&gt;Neto = min(Daño - Deducible, CoberturaMax)&lt;br&gt;Control de estado del siniestro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="c2">
          <mxGeometry x="550" y="40" width="270" height="85" as="geometry" />
