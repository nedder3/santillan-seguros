        <mxCell id="e_pol_fecha" value="vigencia" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;" edge="1" parent="grp_domain" source="cls_poliza" target="cls_fecha">
          <mxGeometry relative="1" as="geometry" />
