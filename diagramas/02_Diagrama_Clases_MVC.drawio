        <mxCell id="e_ctrl_data" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="grp_ctrl" target="grp_data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pol_aseg" value="asociación (titular)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1.5;" edge="1" parent="grp_domain" source="cls_poliza" target="cls_aseg">
          <mxGeometry relative="1" as="geometry" />
