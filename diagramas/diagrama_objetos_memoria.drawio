        <!-- Header Cátedra -->
        <mxCell id="h1" value="&lt;b&gt;SISTEMA FEDERACIÓN SANTILLÁN — DIAGRAMA DE MEMORIA (STACK vs HEAP)&lt;/b&gt;&lt;br&gt;Evaluación de Punteros, Aliasing y Tríada Sagrada (Copy, Clone, Equals) | C# .NET 8&lt;br&gt;Autor: nedder3 (arij.dev@gmail.com) | Cátedra: Programación Orientada a Objetos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;fontColor=#f8fafc;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1300" height="60" as="geometry" />
        </mxCell>

        <!-- ZONA 1: STACK (Variables Locales de Referencia) -->
        <mxCell id="zone_stack" value="VARIABLES LOCALES (STACK / PILA)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontStyle=1;fontSize=13;fontColor=#0369a1;" vertex="1" parent="1">
